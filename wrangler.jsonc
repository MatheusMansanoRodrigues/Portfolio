{
  "name": "mansano-presence",
  "main": "party/server.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "PresenceServer" }
    ]
  },

  // Durable Object migration — necessário na primeira vez que a classe é criada
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PresenceServer"] }
  ]
}
